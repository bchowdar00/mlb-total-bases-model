# Vantage Edge — environment variables
# Copy this file to .env and fill in the values you need.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (required by the Node server) ───────────────────────────────────
# Postgres connection string, e.g. a free Neon serverless database.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Projection engine ────────────────────────────────────────────────────────
# Directory containing the FanGraphs CSV used by server/model_engine.py.
# Default: <repo_root>/data/  (regenerate it with scripts/fetch_data.py)
# MLB_DATA_DIR=/path/to/data
# Season to project (default 2025)
# MLB_PROJECTION_SEASON=2025

# ─── Seed route (optional) ────────────────────────────────────────────────────
# Enables POST /api/seed for demo data. If SEED_TOKEN is unset, the route is
# disabled — there is no default token.
# SEED_TOKEN=choose-a-long-random-string
